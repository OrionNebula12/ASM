
#ifdef _FE8_
#include "Data/FE8.lyn.event"
#endif
#ifdef _FE7_
#include "Data/FE7.lyn.event"
#endif
#ifdef _FE6_
#include "Data/FE6.lyn.event"
#endif

#include "AsmHooks.lyn.event"

ALIGN 4
MaxNumberOfFrames:
WORD 900

#ifndef jumpToHack
	#define jumpToHack(offset) "BYTE 0x00 0x4B 0x18 0x47; POIN (offset|0x1); PROTECT CURRENTOFFSET-8 CURRENTOFFSET-1"
#endif

// NewEkrBattleDeamon runs once when a battle animation starts. The stub replays the
// four prologue instructions it displaces - see EndBattleIfBroken.asm.
PUSH
#ifdef _FE8_
ORG 0x4FD60
#endif
#ifdef _FE7_
ORG 0x4B1AC
#endif
#ifdef _FE6_
ORG 0x42584
#endif
jumpToHack(CallStartEndBrokenBattleProc)
POP
