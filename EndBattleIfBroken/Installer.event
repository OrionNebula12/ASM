
#ifdef _FE8_
#include "Data/FE8_AsmHooks.lyn.event"
#include "Data/FE8.lyn.event"
#endif
#ifdef _FE7_
#include "Data/FE7_AsmHooks.lyn.event"
#include "Data/FE7.lyn.event"
#endif
#ifdef _FE6_
#include "Data/FE6_AsmHooks.lyn.event"
#include "Data/FE6.lyn.event"
#endif

// ldr r0, =0x08B9A99C
// movs r1, #3
// blh 0x8004494 
// str r0, [r4] 
// ldr r1, =0x203e000 


ALIGN 4
MaxNumberOfFrames:
WORD 900

#ifndef callHackNew
	#define callHackNew(offset) "BYTE $01 $4B $9E $46 $00 $F8 $01 $E0; POIN (offset|0x1)"
    #define jumpToHack(offset) "BYTE 0x00 0x4B 0x18 0x47; POIN (offset|0x1); PROTECT CURRENTOFFSET-8 CURRENTOFFSET-1"
#endif 

// NewEkrBattleDeamon runs once when a battle animation starts. The stub replays the
// four prologue instructions it displaces - see EndBattleIfBroken.asm.
PUSH
#ifdef _FE8_
ORG 0x4FD60
#endif
#ifdef _FE7_
ORG 0x4B1B0
callHackNew(CallStartEndBrokenBattleProcFE7)
#endif
#ifdef _FE6_
ORG 0x42584
#endif
// jumpToHack(CallStartEndBrokenBattleProc)
POP
